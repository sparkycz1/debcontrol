# Copy this file to `.env` and fill in real values.
# `.env` is NEVER committed (see .gitignore).

# --- Application ---
APP_ENV=development
# A long random string, used for signing (session cookies etc. in a later phase).
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-generate-a-real-secret

# --- Encryption of sensitive data in the DB (SSH passwords / private keys) ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- PostgreSQL ---
POSTGRES_USER=debcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=debcontrol
# Inside the docker-compose network, the service name "db" is used as the host.
DATABASE_URL=postgresql+asyncpg://debcontrol:change-me@db:5432/debcontrol

# --- Redis (cache + arq task queue) ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# --- SSH ---
# Directory for future SSH-related data (currently unused; reserved for
# audit logs / temp files).
SSH_DATA_DIR=/app/data
# Timeout for establishing an SSH connection (seconds).
SSH_CONNECT_TIMEOUT=10

# --- Logging ---
LOG_LEVEL=INFO

# --- Caddy (only used when running with docker-compose.caddy.yml) ---
# Public domain name pointing at this server. Caddy uses it to request a
# trusted certificate from Let's Encrypt automatically.
DOMAIN=debcontrol.example.com
# Email used for Let's Encrypt account/expiry notices.
ACME_EMAIL=admin@example.com
