# Zkopíruj tento soubor jako `.env` a doplň skutečné hodnoty.
# `.env` se NIKDY necommituje (viz .gitignore).

# --- Aplikace ---
APP_ENV=development
# Náhodný dlouhý řetězec, použije se pro podepisování (session cookies apod. v pozdější fázi).
# Vygeneruj např.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-generate-a-real-secret

# --- Šifrování citlivých dat v DB (SSH hesla / privátní klíče) ---
# Fernet klíč. Vygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- PostgreSQL ---
POSTGRES_USER=debcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=debcontrol
# Uvnitř docker-compose sítě se používá jméno služby "db" jako host.
DATABASE_URL=postgresql+asyncpg://debcontrol:change-me@db:5432/debcontrol

# --- Redis (cache + fronta úloh přes arq) ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# --- SSH ---
# Adresář, kam se ukládá known_hosts / evidence otisků klíčů spravovaných strojů.
SSH_DATA_DIR=/app/data
# Timeout pro navázání SSH spojení (sekundy).
SSH_CONNECT_TIMEOUT=10

# --- Logování ---
LOG_LEVEL=INFO
