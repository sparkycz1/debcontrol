# Copy this file to `.env` and fill in real values.
# `.env` is NEVER committed (see .gitignore).

# --- Application ---
APP_ENV=development
# A long random string, used for signing (session cookies etc. in a later phase).
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-generate-a-real-secret

# Host port the web app is published on (container always listens on 8080
# internally). Change this if 8080 is already taken on this host, or you're
# running more than one debcontrol instance on it.
APP_PORT=8080

# Host network interface the port above is published on. Default 0.0.0.0
# (every interface — reachable from anywhere that can reach this host,
# typically fine behind a firewall or a reverse proxy). Set to 127.0.0.1 to
# only allow local connections (e.g. a reverse proxy running directly on
# this host, not as its own container) without editing docker-compose.yml.
APP_BIND_ADDRESS=0.0.0.0

# Which reverse proxies to trust the X-Forwarded-Proto header from, so the
# app knows a request actually arrived as HTTPS even though the proxy talks
# to it in plain HTTP — without this, WebAuthn/passkeys and OIDC login both
# fail behind any TLS-terminating reverse proxy (bundled Caddy or your
# own), since the app would otherwise think every request is plain HTTP no
# matter what the browser used. "*" (default) trusts any peer — safe even
# from a direct, unproxied client, since a forged header can only make a
# check elsewhere (a WebAuthn origin, an OIDC redirect_uri) fail, never
# spoof it into passing. Narrow this to your proxy's IP/subnet (comma-
# separated, e.g. "172.20.0.0/16,203.0.113.5") if you'd rather not rely on
# that. See app/core/proxy_headers.py.
TRUSTED_PROXY_IPS=*

# Also trust X-Forwarded-For from a TRUSTED_PROXY_IPS peer, to correct
# request.client.host (the audit log's IP column, and the login/TOTP rate
# limiter's per-source bucket key) to the real client behind a reverse
# proxy instead of the proxy's own address — otherwise every request
# behind any proxy shows up as coming from the proxy itself. Off by
# default: unlike TRUSTED_PROXY_IPS above, trusting this from just anyone
# would let an attacker spoof a different "source" on every login/TOTP
# attempt and defeat the rate limiter entirely. Only turn this on once
# you've also narrowed TRUSTED_PROXY_IPS above to your actual proxy's own
# address/subnet (not "*") — see app/core/proxy_headers.py.
TRUST_FORWARDED_FOR=false

# --- Custom branding (optional) ---
# Replace the built-in icon+wordmark (header, browser tab favicon, login
# page) with your own. Each accepts either a URL (http(s):// or a data:
# URI, used as-is) or a local filesystem path that the app reads and
# serves itself — bind-mount a directory into the container to use this
# (see the "Custom branding" section in wiki/Installation.md for the
# docker-compose.yml snippet); a bare path here with nothing mounted at
# it 404s. Unset (default) keeps the built-in default for either. See
# app/web/branding.py.
# CUSTOM_LOGO=/app/branding/logo.svg
# CUSTOM_FAVICON=/app/branding/favicon.png

# --- Encryption of sensitive data in the DB (SSH passwords / private keys) ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- PostgreSQL ---
# The app builds its connection URL from these — no need to also write out
# DATABASE_URL yourself. Set DATABASE_URL directly instead if you need
# something these can't express (a different host/port, a managed DB).
POSTGRES_USER=debcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=debcontrol
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Web process's own DB connection pool size (not the worker's — see
# wiki/Host-Requirements.md). Defaults are already larger than
# SQLAlchemy's own (5/10); raise them for a fleet in the hundreds/thousands
# with several admins keeping pages open at once, and raise Postgres'
# max_connections to comfortably exceed DB_POOL_SIZE + DB_MAX_OVERFLOW.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# --- Redis (Celery broker + result backend, and the login rate limiter) ---
# Same as above: the app builds REDIS_URL from REDIS_PASSWORD unless you set
# REDIS_URL directly.
REDIS_PASSWORD=change-me
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# --- SSH ---
# Directory for future SSH-related data (currently unused — created at
# startup and reserved for e.g. temp files during an SSH operation; the
# app's own SSH private key and the audit log both live in Postgres, not
# here).
SSH_DATA_DIR=/app/data
# Timeout for establishing an SSH connection (seconds).
SSH_CONNECT_TIMEOUT=10

# How often (seconds) Celery Beat schedules a refresh of OS/kernel/CPU/RAM/
# disk facts (and installed packages, and update availability) for every
# machine. Default: 600 (10 minutes). Read once when the `beat` container
# starts — restart it after changing this.
FACTS_REFRESH_INTERVAL_SECONDS=600

# How often (seconds) the "is it alive" status badge's reachability sweep
# (plain TCP connect to the SSH port, no authentication) runs for every
# machine. Default: 60 (one minute).
REACHABILITY_CHECK_INTERVAL_SECONDS=60

# How many machines the reachability sweep checks at once (a concurrency
# cap, not a process/thread count). Default 20 easily finishes a sweep of a
# few hundred machines within the interval above; raise it for a fleet in
# the thousands so one sweep reliably finishes before the next is due — see
# wiki/Host-Requirements.md.
# REACHABILITY_CHECK_CONCURRENCY=20

# How often (seconds) the Monitoring tab's CPU/RAM/disk-usage sample (and
# failed-service count) is taken for every machine. Default: 120 (two
# minutes) — a real SSH round trip, so between the two cadences above.
MONITORING_INTERVAL_SECONDS=120

# Comma-separated absolute path prefixes the Logs tab's "view a file" feature
# may read from a managed machine (beyond the journal, which needs no path).
# A UX guardrail, not a hard security boundary — see that setting's own
# docstring in app/core/config.py.
LOG_FILE_ALLOWED_PATHS=/var/log,/var/lib/docker/containers

# Bearer token that a machine must present when self-registering via
# POST /api/inform (see wiki: Machine Requirements). Treat this like
# a password — anyone with it can create pending machine entries.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
INFORM_TOKEN=change-me-generate-a-real-token

# Max time (seconds) allowed for a full update/upgrade/autoremove/autoclean
# run on one machine. Default: 1800 (30 minutes).
UPDATE_TIMEOUT_SECONDS=1800

# --- Logging ---
LOG_LEVEL=INFO

# --- Timezone ---
# IANA timezone name (e.g. Europe/Prague), applied to every container (db,
# redis, web, worker, beat, migrate, and caddy if used) and used by the app
# itself to display every timestamp in the UI (audit log, "last refreshed"/
# "last run" times, etc.) in local time instead of UTC. Defaults to UTC if
# unset. Data itself is always stored as UTC regardless of this; scheduled
# tasks' cron expressions are also always interpreted as UTC, deliberately,
# with no per-schedule override.
TZ=UTC

# --- Authentication ---
# Nothing to set here — RBAC roles/permissions, LDAP, OIDC, and TOTP are
# all configured from inside the app (Users/Roles/Settings pages) once
# it's running, not via environment variables. Bootstrap the first admin
# account with: docker compose exec web python scripts/create_admin.py
# --username admin (see wiki/Installation.md).

# --- Backups (scripts/backup.sh / scripts/restore.sh) ---
# Both are optional — only read by those two scripts, never by the app
# itself. See wiki/Installation.md ("Backups") for what gets backed up and
# a ready-to-use cron line.
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14

# --- Caddy (only used when running with docker-compose.caddy.yml) ---
# Public domain name pointing at this server. Caddy uses it to request a
# trusted certificate from Let's Encrypt automatically.
DOMAIN=debcontrol.example.com
# Email used for Let's Encrypt account/expiry notices.
ACME_EMAIL=admin@example.com
