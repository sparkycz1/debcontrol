# Vývojářské přepisy — zkopíruj jako `docker-compose.override.yml`
# (ten už je v .gitignore, takže se necommituje) a uprav dle potřeby.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Bind mount zdrojáků + `--reload` pro rychlou iteraci bez rebuildu image
# a publikace DB/Redis portů na hostitele pro připojení nástrojem dle výběru.

services:
  web:
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
    volumes:
      - ./app:/app/app
      - ssh_data:/app/data

  worker:
    command: ["arq", "app.tasks.worker.WorkerSettings", "--watch", "app"]
    volumes:
      - ./app:/app/app
      - ssh_data:/app/data

  db:
    ports:
      - "127.0.0.1:5432:5432"

  redis:
    ports:
      - "127.0.0.1:6379:6379"
