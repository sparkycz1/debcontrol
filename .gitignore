# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Virtual envs
.venv/
venv/

# uv
uv.lock.tmp

# Secrets / config — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# SSH known_hosts store (runtime data, not source)
data/known_hosts
data/*.db

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code — agent worktrees and local session state, never source
.claude/

# Docker
docker-compose.override.yml

# Ansible — real inventories/vars hold hostnames and a bearer token
ansible/inventory.ini
ansible/group_vars/all.yml
!ansible/group_vars/all.yml.example
